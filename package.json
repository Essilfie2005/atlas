{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Project ATLAS — Pan-African Payment Infrastructure Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @atlas/db run db:generate",
    "db:migrate": "pnpm --filter @atlas/db run db:migrate",
    "db:studio": "pnpm --filter @atlas/db run db:studio",
    "db:seed": "pnpm --filter @atlas/db run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "adm-zip": "^0.6.1",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.9.0"
}
