  },
  "dependencies": {
    "@atlas/adapters": "workspace:*",
    "@atlas/core": "workspace:*",
    "axios": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
