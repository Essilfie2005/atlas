# =============================================================================
# Project ATLAS — Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://atlas:atlas_dev_password@localhost:5432/atlas_db?schema=public"

# ─── Cache ────────────────────────────────────────────────────────────────────
# Redis connection string
REDIS_URL="redis://:atlas_redis_password@localhost:6379/0"

# ─── Message Queue ────────────────────────────────────────────────────────────
# RabbitMQ connection string
RABBITMQ_URL="amqp://atlas:atlas_rabbit_password@localhost:5672/atlas"

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT signing secret — MUST be at least 64 bytes of random data in production
# Generate: openssl rand -base64 64
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-64"

# Atlas webhook and API key signing secret — MUST be at least 32 bytes in production
# Generate: openssl rand -base64 32
ATLAS_SIGNING_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# ─── Payment Providers ────────────────────────────────────────────────────────
# Paystack (Ghana / Nigeria)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Observability ────────────────────────────────────────────────────────────
# Log level: error | warn | info | debug
LOG_LEVEL=debug
